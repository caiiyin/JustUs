generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 생애주기 태그 고정값 (8개)
// API 입출력은 한국어 표시명 사용, DB 저장값은 이 enum 코드명
enum LifeStageTag {
  INFANT_FAMILY   // 영유아 동반
  CHILDREN_FAMILY // 어린이 동반
  TEEN            // 청소년
  YOUNG_SOLO      // 청년·1인
  COUPLE_NEWLYWED // 커플·신혼
  MIDDLE_AGED     // 중장년
  SENIOR          // 시니어
  PET_FAMILY      // 반려동물 동반
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String
  lifeStageTags LifeStageTag[]
  createdAt     DateTime       @default(now())

  reviews   Review[]
  favorites Favorite[]

  @@map("users")
}

model Place {
  id          Int          @id @default(autoincrement())
  name        String
  address     String
  lat         Float
  lng         Float
  category    String
  phone       String?
  hours       String?
  image       String?
  tags        String[]
  createdAt   DateTime     @default(now())

  courseItems CourseItem[]

  @@map("places")
}

model Course {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  region        String
  theme         String
  lifeCycleTags LifeStageTag[]
  duration      String
  createdAt     DateTime       @default(now())

  courseItems CourseItem[]
  reviews     Review[]
  favorites   Favorite[]

  @@map("courses")
}

model CourseItem {
  id       Int @id @default(autoincrement())
  courseId Int
  placeId  Int
  order    Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  place  Place  @relation(fields: [placeId], references: [id])

  @@unique([courseId, order])
  @@map("course_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  rating    Int
  content   String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorites")
}
