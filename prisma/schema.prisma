generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  passwordHash  String
  name          String
  lifeStageTags LifeStageTag[]
  createdAt     DateTime       @default(now())
  favorites     Favorite[]
  reviews       Review[]

  @@map("users")
}

model Place {
  id          Int          @id @default(autoincrement())
  name        String
  address     String
  lat         Float
  lng         Float
  category    String
  phone       String?
  hours       String?
  image       String?
  tags        String[]
  createdAt   DateTime     @default(now())
  courseItems CourseItem[]

  @@map("places")
}

model Course {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  region        String
  theme         String
  lifeCycleTags LifeStageTag[]
  duration      String
  estimatedTime Int
  createdAt     DateTime       @default(now())
  courseItems   CourseItem[]
  favorites     Favorite[]
  reviews       Review[]

  @@map("courses")
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())

  @@map("notices")
}

model CourseItem {
  id       Int    @id @default(autoincrement())
  courseId Int
  placeId  Int
  order    Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  place    Place  @relation(fields: [placeId], references: [id])

  @@unique([courseId, order])
  @@map("course_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  rating    Int
  content   String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorites")
}

enum LifeStageTag {
  INFANT_FAMILY
  CHILDREN_FAMILY
  TEEN
  YOUNG_SOLO
  COUPLE_NEWLYWED
  MIDDLE_AGED
  SENIOR
  PET_FAMILY
}
